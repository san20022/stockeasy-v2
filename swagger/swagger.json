    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "Planned OAuth access token. The authentication provider and token configuration will be finalized during implementation."
            }
        },
        "parameters": {
            "Id": {
                "name": "id",
                "in": "path",
                "required": true,
                "description": "Unique resource identifier.",
                "schema": {
                    "type": "string",
                    "example": "65f1a2b3c4d5e6f789012345"
                }
            }
        },
        "schemas": {
            "ProductInput": {
                "type": "object",
                "required": [
                    "name",
                    "quantity",
                    "price",
                    "category",
                    "sku",
                    "description",
                    "supplier"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Wireless Mouse"
                    },
                    "quantity": {
                        "type": "integer",
                        "minimum": 0,
                        "example": 50
                    },
                    "price": {
                        "type": "number",
                        "minimum": 0,
                        "example": 19.99
                    },
                    "category": {
                        "type": "string",
                        "example": "Electronics"
                    },
                    "sku": {
                        "type": "string",
                        "example": "WM-001"
                    },
                    "description": {
                        "type": "string",
                        "example": "Wireless computer mouse"
                    },
                    "supplier": {
                        "type": "string",
                        "example": "65f1a2b3c4d5e6f789012345"
                    }
                }
            },
            "Product": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/ProductInput"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "_id": {
                                "type": "string",
                                "example": "65f1a2b3c4d5e6f789012345"
                            }
                        }
                    }
                ]
            },
            "SupplierInput": {
                "type": "object",
                "required": [
                    "name",
                    "email",
                    "phone",
                    "company",
                    "address"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "John Smith"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "john@supplier.com"
                    },
                    "phone": {
                        "type": "string",
                        "example": "8015551234"
                    },
                    "company": {
                        "type": "string",
                        "example": "Tech Supplies Inc."
                    },
                    "address": {
                        "type": "string",
                        "example": "Salt Lake City, Utah"
                    }
                }
            },
            "Supplier": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/SupplierInput"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "_id": {
                                "type": "string",
                                "example": "65f1a2b3c4d5e6f789012346"
                            }
                        }
                    }
                ]
            },
            "CategoryInput": {
                "type": "object",
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Electronics"
                    },
                    "description": {
                        "type": "string",
                        "example": "Electronic devices and accessories"
                    }
                }
            },
            "Category": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/CategoryInput"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "_id": {
                                "type": "string",
                                "example": "65f1a2b3c4d5e6f789012347"
                            }
                        }
                    }
                ]
            },
            "InventoryTransactionInput": {
                "type": "object",
                "required": [
                    "productId",
                    "type",
                    "quantity"
                ],
                "properties": {
                    "productId": {
                        "type": "string",
                        "example": "65f1a2b3c4d5e6f789012345"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "addition",
                            "removal",
                            "adjustment"
                        ],
                        "example": "addition"
                    },
                    "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "example": 20
                    },
                    "notes": {
                        "type": "string",
                        "example": "New stock received from supplier"
                    }
                }
            },
            "InventoryTransaction": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/InventoryTransactionInput"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "_id": {
                                "type": "string",
                                "example": "65f1a2b3c4d5e6f789012348"
                            },
                            "date": {
                                "type": "string",
                                "format": "date-time",
                                "example": "2026-11-21T10:00:00Z"
                            }
                        }
                    }
                ]
            },
            "Error": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Resource not found."
                    }
                }
            }
        },
        "responses": {
            "BadRequest": {
                "description": "The request contains invalid data.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "Unauthorized": {
                "description": "Authentication is required or the access token is invalid.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "NotFound": {
                "description": "The requested resource was not found.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "ServerError": {
                "description": "An unexpected server error occurred.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            }
        }
    }
}